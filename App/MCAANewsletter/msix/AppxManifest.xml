<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest. The Windows release job (.github/workflows/release.yml)
  copies this into the pack layout, substituting @VERSION@ with the 4-part MSIX
  version (csproj X.Y.Z -> X.Y.Z.0), then runs `makeappx pack`.

  LOAD-BEARING: `Publisher` below MUST exactly equal the Subject (CN=...) of the
  Azure Artifact Signing certificate profile, or the signing step rejects the
  package. It is hardcoded here (the CN is public - it is in every signed
  artifact), NOT freely chosen. It reads "Circuit Stitch" rather than the art
  association because the certificate is issued against that verified identity;
  Windows shows it on the install prompt while the app itself is branded MCAA.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="com.circuitstitch.apps.mcaanewsletter"
      Publisher="CN=Circuit Stitch, O=Circuit Stitch, L=West Sacramento, S=California, C=US"
      Version="@VERSION@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MCAA Newsletter</DisplayName>
    <PublisherDisplayName>Circuit Stitch</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763.0 (Win10 1809) is the floor for App Installer auto-update.
         The target machine is Windows 11, so this is a formality. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- Win32 full-trust app (not UWP): EntryPoint is the sentinel
         Windows.FullTrustApplication, paired with the runFullTrust capability.
         Full trust is not optional here - the app drives Word over COM. -->
    <Application Id="MCAANewsletter" Executable="MCAA Newsletter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="MCAA Newsletter"
          Description="Produces the monthly Mendocino County Art Association newsletter."
          BackgroundColor="transparent"
          Square150x150Logo="Images\Square150x150Logo.png"
          Square44x44Logo="Images\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
