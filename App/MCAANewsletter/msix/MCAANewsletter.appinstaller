<?xml version="1.0" encoding="utf-8"?>
<!--
  App Installer file. The Windows release job substitutes @VERSION@ (4-part:
  csproj X.Y.Z -> X.Y.Z.0) and @BASEURL@ (the AZURE_DOWNLOAD_BASE_URL repo
  variable, no trailing slash), then uploads this alongside the signed .msix.

  Why @BASEURL@ points at Azure Blob Storage rather than GitHub Releases: App
  Installer fetches these URLs anonymously and needs them direct and stable.
  GitHub's /releases/latest/download/ redirects twice to an expiring signed URL
  and serves application/octet-stream; the blob answers 200 with
  application/appinstaller. This URL is baked into every installed copy, so it
  has to keep working. Hosting outside GitHub costs nothing in trust: the anchor
  is the .msix's Authenticode signature, which Windows verifies before
  installing regardless of where the bytes came from.

  Both blob names are STABLE and overwritten each release, so this URL keeps
  working the way GitHub's .../releases/latest/download/ did. The upload runs on
  the `release: published` event (.github/workflows/publish.yml), so the
  draft -> human-review -> publish flow is still the release gate: nothing
  reaches the blob, and so nothing is offered as an update, until you click
  Publish on the draft.

  UpdateSettings/OnLaunch with HoursBetweenUpdateChecks="0" means Windows checks
  on every launch and installs quietly in the background. This is deliberate:
  there is one non-technical user, and an update she has to notice and click is
  an update she will not get. No ShowPrompt, no ForceUpdateFromAnyVersion - the
  update lands and the next launch is the new version.

  `Publisher` must match AppxManifest.xml / the Artifact Signing cert Subject.
-->
<AppInstaller
    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
    Version="@VERSION@"
    Uri="@BASEURL@/MCAANewsletter.appinstaller">
  <MainPackage
      Name="com.circuitstitch.apps.mcaanewsletter"
      Publisher="CN=Circuit Stitch, O=Circuit Stitch, L=West Sacramento, S=California, C=US"
      Version="@VERSION@"
      ProcessorArchitecture="x64"
      Uri="@BASEURL@/MCAANewsletter.msix" />
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="0" />
  </UpdateSettings>
</AppInstaller>
